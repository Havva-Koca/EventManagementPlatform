@model EditEventViewModel

@{
    ViewData["Title"] = "Edit Event";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-4">Edit Event</h2>

        <form asp-controller="Events" asp-action="Edit" asp-route-id="@Model.EventId" method="post">
            <input type="hidden" asp-for="EventId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6">
                    <div class="row">
                        <div class="col-7 form-group mb-3">
                            <label asp-for="StartDate"></label>
                            <input asp-for="StartDate" type="date" class="form-control" />
                            <span asp-validation-for="StartDate" class="text-danger"></span>
                        </div>
                        <div class="col-5 form-group mb-3">
                            <label asp-for="StartTime"></label>
                            <select asp-for="StartTime" asp-items="Model.TimeSlots" class="form-control">
                                <option value="">--</option>
                            </select>
                            <span asp-validation-for="StartTime" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="row">
                        <div class="col-7 form-group mb-3">
                            <label asp-for="EndDate"></label>
                            <input asp-for="EndDate" type="date" class="form-control" />
                            <span asp-validation-for="EndDate" class="text-danger"></span>
                        </div>
                        <div class="col-5 form-group mb-3">
                            <label asp-for="EndTime"></label>
                            <select asp-for="EndTime" asp-items="Model.TimeSlots" class="form-control">
                                <option value="">--</option>
                            </select>
                            <span asp-validation-for="EndTime" class="text-danger"></span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Capacity"></label>
                <input asp-for="Capacity" type="number" min="1" class="form-control" />
                <span asp-validation-for="Capacity" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="CategoryId"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories" class="form-control">
                    <option value="">-- Select Category --</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>

            <hr />
            <h5 class="mb-3">Venue Details</h5>

            <div class="form-group mb-3">
                <label asp-for="VenueName"></label>
                <input asp-for="VenueName" class="form-control" />
                <span asp-validation-for="VenueName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="VenueStreet"></label>
                <input asp-for="VenueStreet" class="form-control" />
                <span asp-validation-for="VenueStreet" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-8 form-group mb-3">
                    <label asp-for="VenueCity"></label>
                    <input asp-for="VenueCity" class="form-control" />
                    <span asp-validation-for="VenueCity" class="text-danger"></span>
                </div>

                <div class="col-md-4 form-group mb-3">
                    <label asp-for="VenuePostalCode"></label>
                    <input asp-for="VenuePostalCode" class="form-control" />
                    <span asp-validation-for="VenuePostalCode" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-primary w-100">Save Changes</button>
        </form>
    </div>
</div>