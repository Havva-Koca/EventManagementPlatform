@model EventDetailsViewModel

@{
    ViewData["Title"] = Model.EventItem.Title;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-3">@Model.EventItem.Title</h2>
        @if (TempData["RegistrationMessage"] != null)
        {
            <div class="alert alert-info">
                @TempData["RegistrationMessage"]
            </div>
        }
        @if (TempData["EventMessage"] != null)
        {
            <div class="alert alert-success">
                @TempData["EventMessage"]
            </div>
        }

        <div class="card p-4 shadow-sm mb-3">
            <dl class="row mb-0">
                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.EventItem.Category.Name</dd>

                <dt class="col-sm-3">Venue</dt>
                <dd class="col-sm-9">@Model.EventItem.Venue.Name, @Model.EventItem.Venue.City</dd>

                <dt class="col-sm-3">Organizer</dt>
                <dd class="col-sm-9">@Model.EventItem.Organizer.FullName</dd>

                <dt class="col-sm-3">Start</dt>
                <dd class="col-sm-9">@Model.EventItem.StartDate.ToString("dd MMM yyyy, HH:mm")</dd>

                <dt class="col-sm-3">End</dt>
                <dd class="col-sm-9">@Model.EventItem.EndDate.ToString("dd MMM yyyy, HH:mm")</dd>

                <dt class="col-sm-3">Capacity</dt>
                <dd class="col-sm-9">@Model.EventItem.Capacity</dd>

       

                <dt class="col-sm-3">Registered</dt>
                <dd class="col-sm-9">@Model.ConfirmedCount / @Model.EventItem.Capacity</dd>

            </dl>
        </div>


        <p>@Model.EventItem.Description</p>
        @if (Model.IsOwnEvent || User.IsInRole("Admin"))
        {
            <a asp-controller="Events" asp-action="Edit" asp-route-id="@Model.EventItem.Id" class="btn btn-outline-primary btn-sm mb-2">Edit Event</a>
        }
        @if (Model.EventItem.Status == EventStatus.Draft && (Model.IsOwnEvent || User.IsInRole("Admin")))
        {
            <form asp-controller="Events" asp-action="Publish" asp-route-id="@Model.EventItem.Id" method="post" style="display:inline;">
                <button type="submit" class="btn btn-success btn-sm mb-2">Publish Event</button>
            </form>
        }
        @if (Model.EventItem.Status == EventStatus.Draft && (Model.IsOwnEvent || User.IsInRole("Admin")))
{
            <form asp-controller="Events" asp-action="Delete" asp-route-id="@Model.EventItem.Id" method="post" style="display:inline;"
                  onsubmit="return confirm('Are you sure you want to permanently delete this event? This cannot be undone.');">
                <button type="submit" class="btn btn-danger btn-sm mb-2">Delete Event</button>
            </form>
}
        @if (Model.EventItem.Status == EventStatus.Published && (Model.IsOwnEvent || User.IsInRole("Admin")))
        {
            <form asp-controller="Events" asp-action="Cancel" asp-route-id="@Model.EventItem.Id" method="post" style="display:inline;"
                  onsubmit="return confirm('Are you sure you want to cancel this event?');">
                <button type="submit" class="btn btn-danger btn-sm mb-2">Cancel Event</button>
            </form>
        }

        @if (!Model.IsOwnEvent)
        {
            if (Model.IsRegistered)
            {
                <form asp-controller="Registrations" asp-action="Cancel" method="post" class="d-inline">
                    <input type="hidden" name="eventId" value="@Model.EventItem.Id" />
                    <button type="submit" class="btn btn-outline-danger btn-sm">Cancel Registration</button>
                </form>
            }
            else if (Model.IsFull)
            {
                <span class="text-muted">This event is full — no longer accepting registrations.</span>
            }
            else if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                <form asp-controller="Registrations" asp-action="Register" method="post" class="d-inline">
                    <input type="hidden" name="eventId" value="@Model.EventItem.Id" />
                    <button type="submit" class="btn btn-primary btn-sm">Register</button>
                </form>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login"
                   asp-route-returnUrl="@Url.Action("Details", "Events", new { id = Model.EventItem.Id })"
                   class="btn btn-primary btn-sm">Login to Register</a>
            }
        }

       
        <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary btn-sm mb-2">All Events</a>
        @if (User.Identity != null && User.Identity.IsAuthenticated)
        {
            <a asp-controller="MyEvents" asp-action="Index" class="btn btn-outline-dark btn-sm mb-2">My Events</a>
        }
    </div>
</div>
