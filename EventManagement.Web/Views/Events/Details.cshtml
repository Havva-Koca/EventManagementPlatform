@model Event

@{
    ViewData["Title"] = Model.Title;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <h2 class="mb-3">@Model.Title</h2>

        <div class="card p-4 shadow-sm mb-3">
            <dl class="row mb-0">
                <dt class="col-sm-3">Category</dt>
                <dd class="col-sm-9">@Model.Category.Name</dd>

                <dt class="col-sm-3">Venue</dt>
                <dd class="col-sm-9">@Model.Venue.Name, @Model.Venue.City</dd>

                <dt class="col-sm-3">Organizer</dt>
                <dd class="col-sm-9">@Model.Organizer.FullName</dd>

                <dt class="col-sm-3">Start</dt>
                <dd class="col-sm-9">@Model.StartDate.ToString("dd MMM yyyy, HH:mm")</dd>

                <dt class="col-sm-3">End</dt>
                <dd class="col-sm-9">@Model.EndDate.ToString("dd MMM yyyy, HH:mm")</dd>

                <dt class="col-sm-3">Capacity</dt>
                <dd class="col-sm-9">@Model.Capacity</dd>

                <dt class="col-sm-3">Registered</dt>
                <dd class="col-sm-9">@Model.Registrations.Count / @Model.Capacity</dd>
            </dl>
        </div>

        <p>@Model.Description</p>

        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Back to Events</a>
    </div>
</div>
