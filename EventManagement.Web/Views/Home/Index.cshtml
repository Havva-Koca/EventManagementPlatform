@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
</div>
@if (User.Identity != null && User.Identity.IsAuthenticated && !User.IsInRole("Organizer") && !User.IsInRole("Admin"))
{
    <form asp-controller="Account" asp-action="RequestOrganizerRole" method="post" class="mt-3">
        <button type="submit" class="btn btn-outline-primary">Request Organizer Role</button>
    </form>
}

@if (TempData["Message"] != null)
{
    <div class="alert alert-info mt-3">@TempData["Message"]</div>
}
