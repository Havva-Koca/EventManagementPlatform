@model PagedResult<Event>

<h2>All Events (Admin)</h2>

@if (!Model.Items.Any())
{
    <p class="text-muted">No events found.</p>
}
else
{
    foreach (var ev in Model.Items)
    {
        var confirmedCount = ev.Registrations.Count(r => r.Status == RegistrationStatus.Confirmed);

        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <a asp-controller="Events" asp-action="Details" asp-route-id="@ev.Id">@ev.Title</a>
                    <span class="badge bg-secondary ms-2">@ev.Status</span>
                    <div class="text-muted small">
                        @ev.StartDate.ToString("dd.MM.yyyy HH:mm") — @ev.Venue.Name — Organizer: @ev.Organizer.FullName — Registered: @confirmedCount / @ev.Capacity
                    </div>
                </div>
                <div>
                   <partial name="_EventActionButtons" model="ev" view-data='@(new ViewDataDictionary(ViewData) { { "ReturnTo", "Admin" } })' />
                </div>
            </div>
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <nav>
            <ul class="pagination">
                @for (int i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                        <a class="page-link" asp-action="Events" asp-route-page="@i">@i</a>
                    </li>
                }
            </ul>
        </nav>
    }
}