@{
    ViewData["Title"] = "Admin Panel";
}

<h2 class="mb-4">Admin Panel</h2>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card p-3 shadow-sm h-100">
            <h5>Organizer Requests</h5>
            <p class="text-muted">Review and approve pending organizer role requests.</p>
            <a asp-action="PendingRequests" class="btn btn-primary btn-sm">View Requests</a>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card p-3 shadow-sm h-100">
            <h5>Categories</h5>
            <p class="text-muted">Manage the list of event categories.</p>
            <a asp-controller="Categories" asp-action="Index" class="btn btn-primary btn-sm">Manage Categories</a>
        </div>
    </div>
</div>